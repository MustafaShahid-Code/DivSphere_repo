# ─────────────────────────────────────────────────────────────
#  Copy to .env for local dev, and set these in your host's
#  environment-variable settings for production.
#  Anything left blank is simply not loaded.
# ─────────────────────────────────────────────────────────────

# REQUIRED before launch — canonical URLs and sitemap depend on it.
PUBLIC_SITE_URL=https://devsphere.qa

# Local /admin login (dev only). Not PUBLIC_ — never shipped to the
# browser as plaintext, only as a SHA-256 hash. Has no effect on the
# production build; see the README's "Going live" section for how
# production admin access works instead.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Google Tag Manager container
PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID
PUBLIC_GA4_ID=

# Meta (Facebook / Instagram) Pixel ID
PUBLIC_META_PIXEL_ID=

# LinkedIn Insight Tag partner ID
PUBLIC_LINKEDIN_PARTNER_ID=

# Google Search Console HTML-tag verification (optional —
# DNS or the Google Analytics method are usually easier)
PUBLIC_GOOGLE_SITE_VERIFICATION=
