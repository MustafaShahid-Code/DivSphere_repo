# Apache config for Hostinger — replaces what netlify.toml used to do
# (Netlify's [[headers]] blocks and the redirect config), since
# Hostinger's shared hosting serves this site through Apache/LiteSpeed
# rather than Netlify's edge network.

# ── Custom 404 ───────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Security headers (every response) ───────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── Cache fingerprinted build assets hard ───────────────────
# Astro names these with a content hash, so a change always gets a
# new filename — safe to cache "forever."
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|woff2?|svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ── Keep the CMS out of search results at the header level too ──
# (SEO.astro already sets <meta name="robots" content="noindex">
# on /admin — this backs it up the same way netlify.toml did.)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^admin(/.*)?$ - [E=NOINDEX_ADMIN:1]
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX_ADMIN
</IfModule>
