---
/**
 * Analytics.astro — campaign and analytics tags.
 *
 * DESIGN NOTES
 * ────────────
 * 1. Every tag is gated behind Google Consent Mode v2. Tags load
 *    immediately but in a *denied* state, and only start collecting
 *    identifiers once the visitor consents. This is what Google Ads
 *    requires for EEA/UK traffic — without it, conversion data from
 *    those regions is dropped and remarketing audiences stop building.
 *
 * 2. Any ID left blank in site.ts is simply not rendered. You can
 *    launch with GA4 only and add Meta/LinkedIn later without a
 *    code change — just set the env var.
 *
 * 3. Nothing loads in development, so local traffic never pollutes
 *    your reporting.
 */
import { site } from "../config/site";

const { gtmId, ga4Id, metaPixelId, linkedinPartnerId } = site.analytics;
const isProd = import.meta.env.PROD;
const hasAnyTag = Boolean(gtmId || ga4Id || metaPixelId || linkedinPartnerId);
const enabled = isProd && hasAnyTag;

// NOTE: inline script bodies are built as strings and injected with
// `set:html`. Writing them as {`...`} inside <script is:inline> makes
// Astro emit the braces and backticks as literal page text.
const consentDefaultScript = `
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
window.gtag = gtag;

var stored = null;
try { stored = localStorage.getItem('ds-consent'); } catch (e) {}
var granted = stored === 'granted';

gtag('consent', 'default', {
  ad_storage: granted ? 'granted' : 'denied',
  ad_user_data: granted ? 'granted' : 'denied',
  ad_personalization: granted ? 'granted' : 'denied',
  analytics_storage: granted ? 'granted' : 'denied',
  functionality_storage: 'granted',
  security_storage: 'granted',
  wait_for_update: 500
});

gtag('set', 'url_passthrough', true);
gtag('set', 'ads_data_redaction', !granted);
`;
---

{
  enabled && (
    <>
      {/* ── Consent Mode v2 — MUST run before any tag ────────── */}
      <script is:inline set:html={consentDefaultScript} />

      {/* ── Google Tag Manager ───────────────────────────────── */}
      {gtmId && (
        <script is:inline set:html={`
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer','${gtmId}');
        `} />
      )}

      {/* ── Google Analytics 4 ───────────────────────────────── */}
      {ga4Id && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
          <script is:inline set:html={`
            gtag('js', new Date());
            gtag('config', '${ga4Id}', { anonymize_ip: true });
          `} />
        </>
      )}

      {/* ── Meta Pixel ───────────────────────────────────────── */}
      {metaPixelId && (
        <script is:inline set:html={`
          !function(f,b,e,v,n,t,s)
          {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window,document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          var dsGranted = false;
          try { dsGranted = localStorage.getItem('ds-consent') === 'granted'; } catch(e) {}
          fbq('consent', dsGranted ? 'grant' : 'revoke');
          fbq('init', '${metaPixelId}');
          fbq('track', 'PageView');
        `} />
      )}

      {/* ── LinkedIn Insight Tag ─────────────────────────────── */}
      {linkedinPartnerId && (
        <script is:inline set:html={`
          window._linkedin_partner_id = "${linkedinPartnerId}";
          window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
          window._linkedin_data_partner_ids.push("${linkedinPartnerId}");
          (function(l){
            if (!l){window.lintrk=function(a,b){window.lintrk.q.push([a,b])};window.lintrk.q=[]}
            var s = document.getElementsByTagName("script")[0];
            var b = document.createElement("script");
            b.type = "text/javascript"; b.async = true;
            b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
            s.parentNode.insertBefore(b, s);
          })(window.lintrk);
        `} />
      )}
    </>
  )
}
