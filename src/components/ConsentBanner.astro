---
/**
 * ConsentBanner.astro — cookie consent tied to Google Consent Mode v2.
 *
 * Only renders when at least one tracking ID is configured, so a site
 * with no tracking never shows a pointless banner.
 *
 * The visitor's choice is stored in localStorage and replayed on every
 * subsequent page load by Analytics.astro, so the banner appears once.
 */
import { site } from "../config/site";

const { gtmId, ga4Id, metaPixelId, linkedinPartnerId } = site.analytics;
const hasTracking = Boolean(gtmId || ga4Id || metaPixelId || linkedinPartnerId);

// Built as a string and injected with `set:html` — see the note in
// Analytics.astro for why {`...`} inside <script is:inline> is wrong.
const bannerScript = `
(function () {
  var KEY = 'ds-consent';
  var banner = document.getElementById('consentBanner');
  if (!banner) return;

  var saved = null;
  try { saved = localStorage.getItem(KEY); } catch (e) {}

  if (saved !== 'granted' && saved !== 'denied') {
    banner.setAttribute('data-open', 'true');
  }

  banner.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-consent]');
    if (!btn) return;
    var choice = btn.getAttribute('data-consent');
    var granted = choice === 'granted';

    try { localStorage.setItem(KEY, choice); } catch (e) {}
    banner.removeAttribute('data-open');

    if (typeof window.gtag === 'function') {
      window.gtag('consent', 'update', {
        ad_storage: granted ? 'granted' : 'denied',
        ad_user_data: granted ? 'granted' : 'denied',
        ad_personalization: granted ? 'granted' : 'denied',
        analytics_storage: granted ? 'granted' : 'denied'
      });
      window.gtag('set', 'ads_data_redaction', !granted);
    }

    if (typeof window.fbq === 'function') {
      window.fbq('consent', granted ? 'grant' : 'revoke');
    }

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'consent_choice', consent_state: choice });
  });
})();
`;
---

{
  hasTracking && (
    <div
      class="consent-banner"
      id="consentBanner"
      role="dialog"
      aria-live="polite"
      aria-label="Cookie consent"
    >
      <div>
        <h2>Cookies on this site</h2>
        <p>
          We use cookies to understand how the site is used and to measure our advertising.
          You can accept, or continue with only the cookies needed to make the site work.
        </p>
      </div>
      <div class="consent-actions">
        <button class="btn btn-primary" type="button" data-consent="granted">
          Accept all
        </button>
        <button class="btn btn-ghost" type="button" data-consent="denied">
          Essential only
        </button>
      </div>
    </div>
  )
}

{hasTracking && <script is:inline set:html={bannerScript} />}

