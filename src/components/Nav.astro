---
/**
 * Nav.astro — site header.
 *
 * Every item is a real <a href="/path">. Crawlers follow these to
 * discover every page; the hash-routed preview gave them nothing.
 * Order comes from `navigation` in src/config/site.ts.
 */
import { site, navigation } from "../config/site";
import brand from "../data/brand.json";

const path = Astro.url.pathname;

/** Marks the current item, and marks a parent when a child is active. */
function isActive(href: string, children?: readonly { href: string }[]) {
  const norm = (p: string) => (p !== "/" && p.endsWith("/") ? p.slice(0, -1) : p);
  const here = norm(path);
  if (norm(href) === here) return true;
  if (children?.some((c) => norm(c.href) === here)) return true;
  // Blog post pages keep the Blog item lit.
  if (href === "/blog" && here.startsWith("/blog")) return true;
  return false;
}
---

<header class="site-nav">
  <div class="nav-inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <img class="brand-mark" src={brand.logoMark} alt="" width="30" height="30" />
      <span class="brand-word">Div<span>Sphere</span></span>
    </a>

    <nav class="primary-links" id="primaryLinks" aria-label="Main navigation">
      {
        navigation.map((item) =>
          "children" in item && item.children ? (
            <div class="nav-item has-dropdown">
              <div class="nav-parent-row">
                <a
                  href={item.href}
                  class:list={["nav-parent-link", { active: isActive(item.href, item.children) }]}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
                <button
                  class="dropdown-toggle"
                  type="button"
                  data-dropdown-toggle
                  aria-expanded="false"
                  aria-label={`Toggle ${item.label} submenu`}
                >
                  <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                    <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </button>
              </div>
              <div class="dropdown-menu">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class:list={{ active: isActive(child.href) }}
                    aria-current={isActive(child.href) ? "page" : undefined}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={{ active: isActive(item.href) }}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <a href="/contact" class="nav-cta desktop-only">Start a project</a>

    <button class="menu-toggle" id="menuToggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="primaryLinks">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M2 4.5H16M2 9H16M2 13.5H16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  // Mobile menu + dropdown accordion. Progressive enhancement only —
  // every link already works with JavaScript disabled.
  const toggle = document.getElementById("menuToggle");
  const links = document.getElementById("primaryLinks");

  toggle?.addEventListener("click", () => {
    const open = links?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });

  document.querySelectorAll<HTMLButtonElement>("[data-dropdown-toggle]").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      const menu = btn.closest(".nav-item")?.querySelector(".dropdown-menu");
      if (!menu) return;
      const isOpen = menu.classList.toggle("open");
      btn.classList.toggle("open", isOpen);
      btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
    });
  });

  // Close the mobile menu on Escape.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && links?.classList.contains("open")) {
      links.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.focus();
    }
  });
</script>
