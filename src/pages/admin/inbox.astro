---
/**
 * inbox.astro — the inquiry inbox.
 *
 * A separate surface from the Decap CMS at /admin/: that page edits
 * git-committed content and authenticates via GitHub OAuth in
 * production, neither of which fits a live, frequently-changing list
 * of form submissions with read/unread state. This page instead talks
 * to public/inbox/api.php, which is backed by a small MySQL database
 * and its own server-side session (see public/inbox/config.sample.php
 * for setup).
 *
 * Static/prerendered like the rest of the site — everything here is
 * client-side fetch() against the PHP API, so it works the same in
 * `astro dev` (pointed at nothing, until you also run the PHP files
 * through something like `php -S`) as it does once deployed.
 */
import { site } from "../../config/site";
import brand from "../../data/brand.json";
import themeData from "../../data/theme.json";
import { resolveTheme } from "../../config/site";
import ThemeToggle from "../../components/ThemeToggle.astro";

import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/manrope";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../../styles/global.css";
import "../../styles/admin-theme.css";

export const prerender = true;

const theme = resolveTheme(themeData.palette);
const themeVars = [
  `--accent:${theme.accent}`,
  `--accent-strong:${theme.accentStrong}`,
  `--accent-soft:${theme.accentSoft}`,
  `--accent-line:${theme.accentLine}`,
  `--on-accent:${theme.onAccent}`,
].join(";");
---

<!doctype html>
<html lang="en" style={themeVars}>
  <head>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("ds-theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Inquiries — {site.name}</title>
    <link rel="icon" type="image/png" href={brand.favicon} />
  </head>
  <body class="admin-body inbox-body">
    <!-- ============== Sign-in screen ============== -->
    <div id="inboxLogin" class="login-body">
      <div class="login-orb" aria-hidden="true"></div>
      <main class="login-shell">
        <div class="login-card">
          <div class="login-mark">
            <img src={brand.logoMark} alt={brand.logoAlt} class="login-mark-logo" />
            <span class="mono">{site.name}</span>
          </div>

          <h1>Inquiries</h1>
          <p class="login-sub">Sign in to read and reply to enquiries.</p>

          <p class="login-error" id="loginError" role="alert" hidden></p>

          <form id="loginForm" class="login-form">
            <div class="field">
              <label for="inUsername">Username</label>
              <input type="text" id="inUsername" name="username" autocomplete="username" required />
            </div>
            <div class="field">
              <label for="inPassword">Password</label>
              <input type="password" id="inPassword" name="password" autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn btn-primary login-submit" id="loginSubmit">Sign in &rarr;</button>
          </form>

          <p class="login-note">
            Same username/password as the content manager. See
            <code>public/inbox/config.sample.php</code> if this hasn't been set up yet.
          </p>
        </div>
      </main>
    </div>

    <!-- ============== Inbox shell ============== -->
    <div id="inboxShell" class="inbox-shell" hidden>
      <header class="inbox-header">
        <div class="inbox-header-left">
          <a href="/admin/" class="inbox-back">&larr; Content manager</a>
          <h1>Inquiries</h1>
        </div>
        <div class="inbox-header-right">
          <button type="button" class="btn-icon" id="refreshBtn" aria-label="Refresh" title="Refresh">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M13.65 2.35A7 7 0 1 0 15 8h-1.5a5.5 5.5 0 1 1-1.6-4.55L10 5.5h5V.5z" fill="currentColor"/>
            </svg>
          </button>
          <button type="button" class="btn-ghost" id="logoutBtn">Sign out</button>
        </div>
      </header>

      <div class="inbox-body-grid">
        <aside class="inbox-list" id="inboxList" aria-label="Inquiries">
          <div class="inbox-empty" id="listEmpty" hidden>No enquiries yet.</div>
        </aside>

        <section class="inbox-detail" id="inboxDetail">
          <div class="inbox-placeholder" id="detailPlaceholder">Select an enquiry to read it.</div>
        </section>
      </div>
    </div>

    <ThemeToggle variant="floating" />

    <script>
      const API = "/inbox/api.php";

      const loginScreen = document.getElementById("inboxLogin");
      const shell = document.getElementById("inboxShell");
      const loginForm = document.getElementById("loginForm") as HTMLFormElement | null;
      const loginError = document.getElementById("loginError");
      const loginSubmit = document.getElementById("loginSubmit") as HTMLButtonElement | null;
      const listEl = document.getElementById("inboxList");
      const listEmpty = document.getElementById("listEmpty");
      const detailEl = document.getElementById("inboxDetail");
      const refreshBtn = document.getElementById("refreshBtn");
      const logoutBtn = document.getElementById("logoutBtn");

      let inquiries: any[] = [];
      let activeId: number | null = null;
      let pollTimer: number | undefined;

      function escapeHtml(str: string): string {
        const div = document.createElement("div");
        div.textContent = str ?? "";
        return div.innerHTML;
      }

      function fmtDate(iso: string): string {
        try {
          return new Date(iso.replace(" ", "T") + "Z").toLocaleString(undefined, {
            month: "short", day: "numeric", hour: "numeric", minute: "2-digit",
          });
        } catch {
          return iso;
        }
      }

      async function api(action: string, opts: RequestInit = {}) {
        const res = await fetch(`${API}?action=${action}`, {
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          ...opts,
        });
        const data = await res.json().catch(() => ({ ok: false, error: "Bad response from server." }));
        if (res.status === 401) {
          showLogin();
        }
        return { status: res.status, data };
      }

      function showLogin() {
        if (pollTimer) window.clearInterval(pollTimer);
        shell?.setAttribute("hidden", "");
        loginScreen?.removeAttribute("hidden");
      }

      function showShell() {
        loginScreen?.setAttribute("hidden", "");
        shell?.removeAttribute("hidden");
        loadList();
        pollTimer = window.setInterval(loadList, 45000);
      }

      function renderList() {
        if (!listEl) return;
        listEl.querySelectorAll(".inbox-row").forEach((el) => el.remove());
        if (listEmpty) listEmpty.hidden = inquiries.length > 0;

        for (const inq of inquiries) {
          const row = document.createElement("button");
          row.type = "button";
          row.className = "inbox-row" + (Number(inq.is_read) ? "" : " unread") + (inq.id === activeId ? " active" : "");
          row.dataset.id = String(inq.id);
          row.innerHTML = `
            <div class="inbox-row-top">
              <span class="inbox-row-name">${escapeHtml(inq.name)}</span>
              <span class="inbox-row-date">${fmtDate(inq.submitted_at)}</span>
            </div>
            <div class="inbox-row-snippet">${escapeHtml((inq.message || "").slice(0, 90))}${inq.message?.length > 90 ? "…" : ""}</div>
          `;
          row.addEventListener("click", () => openInquiry(inq.id));
          listEl.appendChild(row);
        }
      }

      async function loadList() {
        const { data } = await api("list");
        if (!data.ok) return;
        inquiries = data.inquiries || [];
        renderList();
      }

      async function openInquiry(id: number) {
        activeId = id;
        renderList();
        if (!detailEl) return;
        detailEl.innerHTML = `<div class="inbox-placeholder">Loading…</div>`;

        const { data } = await api(`detail&id=${id}`);
        if (!data.ok) {
          detailEl.innerHTML = `<div class="inbox-placeholder">Couldn't load this enquiry.</div>`;
          return;
        }

        const inq = data.inquiry;
        const replies = data.replies || [];

        detailEl.innerHTML = `
          <div class="detail-head">
            <h2>${escapeHtml(inq.name)}</h2>
            <div class="detail-meta">
              <a href="mailto:${escapeHtml(inq.email)}">${escapeHtml(inq.email)}</a>
              ${inq.company ? `<span>&middot; ${escapeHtml(inq.company)}</span>` : ""}
              ${inq.service ? `<span class="tag">${escapeHtml(inq.service)}</span>` : ""}
            </div>
            <div class="detail-date">${fmtDate(inq.submitted_at)}</div>
          </div>
          <div class="detail-message">${escapeHtml(inq.message)}</div>
          <div class="detail-thread" id="detailThread"></div>
          <div class="reply-box">
            <textarea id="replyText" placeholder="Write a reply…" rows="5"></textarea>
            <div class="reply-actions">
              <span class="reply-status" id="replyStatus"></span>
              <button type="button" class="btn btn-primary" id="replySend">Send reply</button>
            </div>
          </div>
        `;

        const thread = document.getElementById("detailThread");
        if (thread && replies.length) {
          thread.innerHTML = replies.map((r: any) => `
            <div class="reply-item ${r.sent_ok ? "" : "reply-failed"}">
              <div class="reply-item-meta">${r.sent_ok ? "Replied" : "Failed to send"} &middot; ${fmtDate(r.sent_at)}</div>
              <div class="reply-item-body">${escapeHtml(r.reply_body)}</div>
            </div>
          `).join("");
        }

        document.getElementById("replySend")?.addEventListener("click", () => sendReply(id));

        // Mark read on open.
        if (!Number(inq.is_read)) {
          await api("mark_read", { method: "POST", body: JSON.stringify({ id, read: true }) });
          const local = inquiries.find((i) => i.id === id);
          if (local) local.is_read = 1;
          renderList();
        }
      }

      async function sendReply(id: number) {
        const textarea = document.getElementById("replyText") as HTMLTextAreaElement | null;
        const status = document.getElementById("replyStatus");
        const btn = document.getElementById("replySend") as HTMLButtonElement | null;
        const body = textarea?.value.trim();
        if (!body) return;

        if (btn) btn.disabled = true;
        if (status) { status.textContent = "Sending…"; status.className = "reply-status"; }

        const { data } = await api("reply", { method: "POST", body: JSON.stringify({ id, body }) });

        if (data.ok) {
          if (textarea) textarea.value = "";
          openInquiry(id);
        } else {
          if (status) { status.textContent = data.error || "Couldn't send that reply."; status.className = "reply-status reply-status-error"; }
          if (btn) btn.disabled = false;
        }
      }

      loginForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (loginError) loginError.hidden = true;
        if (loginSubmit) { loginSubmit.disabled = true; loginSubmit.textContent = "Signing in…"; }

        const data = new FormData(loginForm);
        const res = await fetch("/inbox/login.php", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ username: data.get("username"), password: data.get("password") }),
        });
        const json = await res.json().catch(() => ({ ok: false, error: "Unexpected error." }));

        if (loginSubmit) { loginSubmit.disabled = false; loginSubmit.textContent = "Sign in →"; }

        if (json.ok) {
          loginForm.reset();
          showShell();
        } else if (loginError) {
          loginError.textContent = json.error || "That username or password didn't match.";
          loginError.hidden = false;
        }
      });

      logoutBtn?.addEventListener("click", async () => {
        await fetch("/inbox/logout.php", { credentials: "same-origin" });
        showLogin();
      });

      refreshBtn?.addEventListener("click", loadList);

      // On load, try the list endpoint — a live session means it succeeds
      // and we can skip straight past the login screen. Checking data.ok
      // (not just HTTP status) matters here: a misconfigured host that
      // serves api.php as a raw static file instead of executing it would
      // still return 200 with the PHP source as text, which must NOT be
      // treated as "signed in".
      (async () => {
        const { status, data } = await api("list");
        if (status === 200 && data && data.ok) {
          inquiries = data.inquiries || [];
          showShell();
          renderList();
        } else if (status !== 401) {
          // Any other non-OK response (network error, bad gateway, that
          // static-file case above) — stay on the login screen rather
          // than showing an empty, broken-looking inbox shell.
          showLogin();
        }
      })();
    </script>

    <style>
      .login-body[hidden] { display: none !important; }
      .login-body {
        min-height: 100vh; display: flex; align-items: center; justify-content: center;
        padding: 24px; position: fixed; inset: 0; z-index: 50; background: var(--ground);
      }
      .login-orb {
        position: fixed; top: 50%; left: 50%; width: 640px; height: 640px;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle, var(--accent-soft) 0%, transparent 70%);
        filter: blur(10px); pointer-events: none; z-index: 0;
      }
      .login-shell { position: relative; z-index: 1; width: 100%; max-width: 400px; }
      .login-card {
        background: linear-gradient(180deg, var(--surface-raised) 0%, var(--surface) 100%);
        border: 1px solid var(--line); border-radius: 16px; padding: 40px 36px;
        box-shadow: 0 24px 64px -24px rgba(0, 0, 0, 0.6);
      }
      .login-mark { display: flex; align-items: center; gap: 8px; margin-bottom: 28px; color: var(--text-muted); font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; }
      .login-mark-logo { width: 20px; height: 20px; display: block; }
      .login-card h1 { font-size: 1.5rem; margin-bottom: 6px; }
      .login-sub { color: var(--text-muted); margin: 0 0 28px; font-size: 0.94rem; }
      .login-error { background: var(--danger-soft); border: 1px solid var(--danger-line); color: var(--danger-text); padding: 11px 14px; border-radius: 8px; font-size: 0.88rem; margin: 0 0 20px; }
      .login-form { display: flex; flex-direction: column; gap: 18px; }
      .login-form .field { display: flex; flex-direction: column; gap: 7px; }
      .login-form label { font-size: 0.82rem; font-weight: 700; color: var(--text-muted); }
      .login-form input {
        background: var(--ground); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px;
        color: var(--text); font-family: var(--font-body); font-size: 0.96rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      .login-form input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
      .login-submit { justify-content: center; margin-top: 6px; width: 100%; }
      .login-note { margin: 24px 0 0; color: var(--text-faint); font-size: 0.78rem; line-height: 1.6; }
      .login-note code { background: var(--ground); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; font-family: var(--font-mono); font-size: 0.92em; }

      .inbox-shell[hidden] { display: none !important; }
      .inbox-shell { min-height: 100vh; display: flex; flex-direction: column; background: var(--ground); }

      .inbox-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 24px; border-bottom: 1px solid var(--line); background: var(--surface-raised);
      }
      .inbox-header-left { display: flex; align-items: center; gap: 18px; }
      .inbox-header-left h1 { font-size: 1.15rem; margin: 0; font-family: var(--font-display); }
      .inbox-back { color: var(--text-muted); font-size: 0.85rem; font-weight: 600; text-decoration: none; }
      .inbox-back:hover { color: var(--text); }
      .inbox-header-right { display: flex; align-items: center; gap: 10px; }

      .btn-icon {
        display: inline-flex; align-items: center; justify-content: center;
        width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--line);
        background: var(--surface); color: var(--text-muted); cursor: pointer;
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      .btn-icon:hover { color: var(--text); border-color: var(--accent-line); }

      .btn-ghost {
        background: transparent; border: 1px solid var(--line); color: var(--text-muted);
        border-radius: 8px; padding: 8px 14px; font-size: 0.85rem; font-weight: 700; cursor: pointer;
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      .btn-ghost:hover { color: var(--text); border-color: var(--accent-line); }

      .inbox-body-grid { flex: 1; display: grid; grid-template-columns: 340px 1fr; min-height: 0; }

      .inbox-list { border-right: 1px solid var(--line); overflow-y: auto; background: var(--surface); }
      .inbox-empty { padding: 40px 20px; text-align: center; color: var(--text-faint); font-size: 0.9rem; }

      .inbox-row {
        display: block; width: 100%; text-align: left; padding: 14px 18px;
        border: none; border-bottom: 1px solid var(--line-soft); background: transparent;
        cursor: pointer; transition: background 0.12s ease;
      }
      .inbox-row:hover { background: var(--surface-raised); }
      .inbox-row.active { background: var(--accent-soft); border-left: 3px solid var(--accent); padding-left: 15px; }
      .inbox-row-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
      .inbox-row-name { font-weight: 700; font-size: 0.92rem; color: var(--text); }
      .inbox-row.unread .inbox-row-name::before {
        content: ""; display: inline-block; width: 7px; height: 7px; border-radius: 50%;
        background: var(--accent); margin-right: 7px; vertical-align: middle;
      }
      .inbox-row-date { font-size: 0.72rem; color: var(--text-faint); white-space: nowrap; }
      .inbox-row-snippet { font-size: 0.82rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .inbox-row.unread .inbox-row-snippet { color: var(--text); }

      .inbox-detail { overflow-y: auto; padding: 32px 40px; }
      .inbox-placeholder { color: var(--text-faint); font-size: 0.95rem; padding: 60px 0; text-align: center; }

      .detail-head h2 { font-size: 1.3rem; margin: 0 0 8px; }
      .detail-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: var(--text-muted); font-size: 0.88rem; margin-bottom: 4px; }
      .detail-meta a { color: var(--accent-text); }
      .detail-meta .tag {
        background: var(--accent-soft); border: 1px solid var(--accent-line); color: var(--accent-text);
        border-radius: 6px; padding: 2px 9px; font-size: 0.76rem; font-weight: 700;
      }
      .detail-date { color: var(--text-faint); font-size: 0.78rem; margin-bottom: 24px; }
      .detail-message {
        background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
        padding: 20px; white-space: pre-wrap; line-height: 1.6; color: var(--text); margin-bottom: 24px;
      }

      .detail-thread { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; }
      .reply-item { background: var(--accent-soft); border: 1px solid var(--accent-line); border-radius: 10px; padding: 16px; }
      .reply-item.reply-failed { background: var(--danger-soft); border-color: var(--danger-line); }
      .reply-item-meta { font-size: 0.74rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
      .reply-item-body { white-space: pre-wrap; line-height: 1.6; color: var(--text); }

      .reply-box textarea {
        width: 100%; background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
        padding: 14px; color: var(--text); font-family: var(--font-body); font-size: 0.95rem;
        line-height: 1.5; resize: vertical;
      }
      .reply-box textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
      .reply-actions { display: flex; align-items: center; justify-content: flex-end; gap: 14px; margin-top: 12px; }
      .reply-status { font-size: 0.82rem; color: var(--text-muted); }
      .reply-status-error { color: var(--danger-text); }

      @media (max-width: 860px) {
        .inbox-body-grid { grid-template-columns: 1fr; }
        .inbox-list { max-height: 40vh; border-right: none; border-bottom: 1px solid var(--line); }
      }
    </style>
  </body>
</html>
