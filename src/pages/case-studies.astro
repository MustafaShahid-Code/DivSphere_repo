---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const caseStudies = (await getCollection("caseStudies", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const categories = [...new Set(caseStudies.map((cs) => cs.data.category))];
const sectors = [...new Set(caseStudies.map((cs) => cs.data.sector))].sort();

const crumbs = [
  { name: "Home", url: "/" },
  { name: "About", url: "/about" },
  { name: "Case Studies", url: "/case-studies" },
];
---

<BaseLayout
  title="Case Studies"
  description="Selected DivSphere work across fintech, logistics, healthcare, banking, and retail — cloud migrations, ERP rollouts, AI models, and security audits."
  breadcrumbs={crumbs}
>
  <div class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">Case Studies</span>
      <h1>Selected engagements.</h1>
      <p class="lede">
        A sample of the work — representative of engagement types across our seven capabilities.
        Full case studies with client details available on request under NDA.
      </p>
    </div>
  </div>

  <div class="wrap" style="padding-top:56px;">
    <!--
      Filtering is client-side progressive enhancement. Every card is
      present in the HTML, so crawlers index all of them regardless.
      Category and sector filters combine with AND logic — picking a
      sector narrows within whichever category pill is already active.
    -->
    <div class="filter-row" id="categoryFilters" data-filter-group="category">
      <button class="filter-pill active" type="button" data-filter="all">All</button>
      {categories.map((cat) => (
        <button class="filter-pill" type="button" data-filter={cat}>{cat}</button>
      ))}
    </div>
    <div class="filter-row filter-row-sector" id="sectorFilters" data-filter-group="sector">
      <button class="filter-pill filter-pill-sector active" type="button" data-filter="all">All sectors</button>
      {sectors.map((sector) => (
        <button class="filter-pill filter-pill-sector" type="button" data-filter={sector}>{sector}</button>
      ))}
    </div>
    <p class="filter-empty" id="filterEmpty" hidden>No case studies match that combination yet.</p>

    <div class="case-grid" id="caseGrid" style="margin-bottom:96px;">
      {
        caseStudies.map((cs) => (
          <article class="case-card reveal" data-category={cs.data.category} data-sector={cs.data.sector}>
            <a href={`/case-studies/${cs.id}`} style="text-decoration:none; color:inherit; display:flex; flex-direction:column; height:100%;">
              <div class="case-visual"><span class="mono">// {cs.data.sector.toUpperCase()}</span></div>
              <div class="case-body">
                <span class="case-sector">{cs.data.sector} &middot; {cs.data.category}</span>
                <h2 style="font-size:1.08rem; font-family:var(--font-display);">{cs.data.title}</h2>
                <p>{cs.data.description}</p>
                <div class="case-metric">{cs.data.metric}</div>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  const cards = document.querySelectorAll<HTMLElement>("#caseGrid .case-card");
  const filterEmpty = document.getElementById("filterEmpty");
  const groups = document.querySelectorAll<HTMLElement>("[data-filter-group]");

  const active: Record<string, string> = { category: "all", sector: "all" };

  function applyFilters() {
    let visibleCount = 0;
    cards.forEach((card) => {
      const matchesCategory = active.category === "all" || card.dataset.category === active.category;
      const matchesSector = active.sector === "all" || card.dataset.sector === active.sector;
      const match = matchesCategory && matchesSector;
      card.style.display = match ? "" : "none";
      if (match) visibleCount++;
    });
    if (filterEmpty) filterEmpty.hidden = visibleCount > 0;
  }

  groups.forEach((group) => {
    const groupKey = group.dataset.filterGroup as string;
    const pills = group.querySelectorAll<HTMLButtonElement>(".filter-pill");
    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        pills.forEach((p) => p.classList.remove("active"));
        pill.classList.add("active");
        active[groupKey] = pill.dataset.filter || "all";
        applyFilters();
      });
    });
  });
</script>

<style>
  .filter-row-sector { margin-top: 12px; }
  .filter-pill-sector {
    font-size: 0.8rem;
    padding: 7px 14px;
    opacity: 0.85;
  }
  .filter-empty {
    color: var(--text-faint);
    font-size: 0.92rem;
    margin: 28px 0 0;
  }
</style>
